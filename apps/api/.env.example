PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Cognito。ローカルでは cognito-local を指す。本番では COGNITO_ENDPOINT を空にし、
# Terraform が作ったユーザープールとクライアント（シークレットなし）の ID を入れる
COGNITO_REGION=ap-northeast-1
COGNITO_ENDPOINT=http://localhost:9229
# pnpm --filter @cognito-prac/api cognito:setup が cognito-local に作って書き込む
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Cookie に Secure を付けるか。HTTPS で配信する環境では true にする
COOKIE_SECURE=false
